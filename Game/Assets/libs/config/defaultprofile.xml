<profile version="0">
	<platforms>
		<PC keyboard="1" xboxpad="1" ps4pad="1"/>
		<XboxOne keyboard="1" xboxpad="1" ps4pad="0"/>
		<PS4 keyboard="1" xboxpad="0" ps4pad="1"/>
	</platforms>
	
	<!--DO NOT REMOVE DEFAULT ACTIONMAP! NEEDED BY CRYACTION.-->
	<actionmap name="default" version="1"/>
	<!---->
	
	<actionmap name="player" version="1">
		<action name="moveleft" onPress="1" onRelease="1" keyboard="a"/>
		<action name="moveright" onPress="1" onRelease="1" keyboard="d"/>
		<action name="moveforward" onPress="1" onRelease="1" keyboard="w"/>
		<action name="moveback" onPress="1" onRelease="1" keyboard="s"/>
		<action name="sprint" onPress="1" onRelease="1" keyboard="lshift" xboxpad="xi_thumbl" ps4pad="pad_l3"/>
		
		<action name="yaw" keyboard="maxis_y" />
		<action name="pitch" keyboard="maxis_x" />
		
		<action name="controller_movey" xboxpad="xi_thumbly" ps4pad="pad_stickly"/>
		<action name="controller_movex" xboxpad="xi_thumblx" ps4pad="pad_sticklx"/>
		<action name="controller_rotateyaw" xboxpad="xi_thumbrx" ps4pad="pad_stickrx"/>
		<action name="controller_rotatepitch" xboxpad="xi_thumbry" ps4pad="pad_stickry"/>
		
		<action name="interact" onPress="1" onRelease="1" keyboard="e" xboxpad="xi_a" ps4pad="pad_cross"/>
		<action name="togglebook" onPress="1" onRelease="0" keyboard="i" xboxpad="xi_back" ps4pad="pad_select"/>
	</actionmap>

	<actionmap name="ui" version="1">
		<action name="togglebook" onPress="1" onRelease="0" keyboard="i" xboxpad="xi_back" ps4pad="pad_select"/>
	</actionmap>
</profile>