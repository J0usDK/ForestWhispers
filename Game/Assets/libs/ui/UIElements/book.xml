<UIElements name="Menus">
	<UIElement name="BookUI" mouseevents="1">
		<GFx file="textures/ui/bookbase/BookUI.gfx" layer="2">
			<Constraints>
				<Align mode="dynamic" valign="center" halign="center" scale="1" max="0"/>
			</Constraints>
		</GFx>
		<functions>
			<function name="SetStringTable" funcname="SetStringTable" desc="Push localization table">
			    <param name="Table" desc="Flat array [id, str, id, str, ...]"/>
			</function>
			<function name="OpenBook" funcname="_root.book_mc.openBook" desc="Shows the book"/>
			<function name="CloseBook" funcname="_root.book_mc.closeBook" desc="Closes the book"/>
			<function name="Inv_SetItems" funcname="_root.book_mc.inventory_mc.setItems">
				<param name="Items" desc="Flat array of items"/>
			</function>
		</functions>
		<events>
            <event name="OnSortName" fscommand="UI_OnSortName" desc="An request for sort items by their names"/>
            <event name="OnSortWeight" fscommand="UI_OnSortWeight" desc="An request for sort items by their weight"/>
            <event name="OnSortType" fscommand="UI_OnSortType" desc="An request for sort items by their type"/>
        </events>
	</UIElement>
</UIElements>