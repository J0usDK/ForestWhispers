<UIElements name="HUD">
	<UIElement name="worldTooltip">
		<GFx file="textures/ui/tooltip/worldTooltip.gfx" layer="1">
			<Constraints>
				<Align mode="dynamic" valign="center" halign="center" scale="1" max="0"/>
			</Constraints>
		</GFx>
		<functions>
			<function name="SetStringTable" funcname="SetStringTable" desc="Push localization table">
			    <param name="Table" desc="Flat array [id, str, id, str, ...]"/>
			</function>
			<function name="Show" funcname="_root.worldTooltip_mc.show" desc="Shows tooltip and starts animation">
				<param name="textID" type="Uint"/>
			</function>
			<function name="Hide" funcname="_root.worldTooltip_mc.hide" desc="Hides tooltip immediately"/>
		</functions>
	</UIElement>
</UIElements>