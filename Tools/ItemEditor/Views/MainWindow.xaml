<Window x:Class="ItemEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:ItemEditor.Views.Components"
        Height="450" Width="1000" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}" AllowsTransparency="False" WindowStyle="SingleBorderWindow">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding ItemEditor.SaveItemCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding ItemEditor.UndoCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding ItemEditor.RedoCommand}"/>
    </Window.InputBindings>

    <Border BorderBrush="{StaticResource BgDark}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource TextMuted}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="Margin" Value="{Binding Source={x:Static SystemParameters.WindowResizeBorderThickness}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock Text="Item Editor" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="15,0,0,0" FontSize="12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SystemButtonStyle}" Click="MinimizeWindow_Click">
                        <Path Data="{StaticResource Icon.Window.Minimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource SystemButtonStyle}" Click="MaximizeWindow_Click">
                        <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource SystemCloseButtonStyle}" Click="CloseWindow_Click">
                        <Path Data="{StaticResource Icon.Window.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Menu Grid.Row="1" Background="{StaticResource BgLite}" Foreground="{StaticResource TextPrimary}" Padding="5,2">
                <MenuItem Header="_File">
                    <MenuItem Header="Select Schema File" Command="{Binding SelectSchemaCommand}"/>
                    <MenuItem Header="Select Assets Folder" Command="{Binding SelectProjectDirectoryCommand}"/>
                    <MenuItem Header="Select Items Folder" Command="{Binding SelectItemsDirectoryCommand}"/>
                    <Separator/>
                    <MenuItem Header="Save Current Item" Command="{Binding ItemEditor.SaveItemCommand}" InputGestureText="Ctrl+S" Style="{StaticResource EmphasizedMenuItemStyle}"/>
                    <MenuItem Header="Save All Items" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" Style="{StaticResource EmphasizedMenuItemStyle}"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Undo" Command="{Binding ItemEditor.UndoCommand}" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Redo" Command="{Binding ItemEditor.RedoCommand}" InputGestureText="Ctrl+Shift+Z"/>
                </MenuItem>
            </Menu>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <components:ItemListPanel Grid.Column="0"/>
                <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderMedium}"/>
                <components:ItemEditorPanel Grid.Column="2"/>
                <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderMedium}"/>
                <components:TraitsListPanel Grid.Column="4"/>
                
            </Grid>
        </Grid>
    </Border>
</Window>
