<UserControl x:Class="ItemEditor.Views.Components.ItemEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ItemEditor.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="480">

    <Grid Background="{StaticResource BgDark}">
        <StackPanel Visibility="{Binding ItemEditor.CurrentItem, Converter={StaticResource NullToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="No Item Selected" FontSize="20" Foreground="{StaticResource TextMuted}" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Select an item from the left panel or create a new one." FontSize="14" Foreground="#555555" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Visibility="{Binding ItemEditor.CurrentItem, Converter={StaticResource NotNullToVis}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">

            <StackPanel Grid.Row="0" Margin="15,15,15,0">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="ITEM ID" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ItemEditor.SaveItemCommand}" CommandParameter="{Binding ItemEditor.CurrentItem}"
                                IsEnabled="{Binding ItemEditor.CanSave}" ToolTip="Save Current Item"
                                Style="{StaticResource IconButtonStyle}" Margin="0,0,5,0">
                            <Path Data="{StaticResource Icon.Action.Save}" Fill="{StaticResource HighlightCyan}" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding ItemsList.DuplicateItemCommand}" CommandParameter="{Binding ItemEditor.CurrentItem}"
                                Style="{StaticResource IconButtonStyle}" ToolTip="Duplicate Current Item" Margin="0,0,5,0">
                            <Path Data="{StaticResource Icon.Action.Duplicate}" Fill="{StaticResource HighlightBlue}" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding ItemsList.DeleteItemCommand}" CommandParameter="{Binding ItemEditor.CurrentItem}"
                                Style="{StaticResource IconButtonStyle}" ToolTip="Delete Current Item">
                            <Path Data="{StaticResource Icon.Action.Delete}" Fill="{StaticResource AccentRed}" Width="18" Height="18" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox Text="{Binding ItemEditor.CurrentItem.ItemID, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MetadataTextBoxStyle}" Margin="0,0,0,20" TextChanged="OnTextBoxTextChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding DataContext.ItemEditor.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding DataContext.ItemEditor.RedoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="DESCRIPTION" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                <TextBox Text="{Binding ItemEditor.CurrentItem.Description.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ValidatedTextBoxStyle}" Margin="0,0,0,20" TextChanged="OnTextBoxTextChanged">
                    <TextBox.InputBindings>
                        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding DataContext.ItemEditor.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding DataContext.ItemEditor.RedoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="GEOMETRY PATH" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <TextBox Text="{Binding ItemEditor.CurrentItem.GeometryPath.Value, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource PathTextBoxStyle}" TextChanged="OnTextBoxTextChanged" LostFocus="GeometryPathTextBox_LostFocus">

                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding DataContext.ItemEditor.ConvertGeometryPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding DataContext.ItemEditor.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding DataContext.ItemEditor.RedoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Command="{Binding ItemEditor.SelectGeometryPathCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Cursor="Hand" 
                            Background="Transparent" BorderThickness="0" ToolTip="Browse for .cgf geometry file">
                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                              Fill="{StaticResource TextMuted}" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <TextBlock Text="ICON PATH" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <TextBox Text="{Binding ItemEditor.CurrentItem.IconPath.Value, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource PathTextBoxStyle}" TextChanged="OnTextBoxTextChanged" LostFocus="IconPathTextBox_LostFocus">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding DataContext.ItemEditor.ConvertIconPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding DataContext.ItemEditor.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding DataContext.ItemEditor.RedoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Command="{Binding ItemEditor.SelectIconPathCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Style="{StaticResource IconButtonStyle}" Width="24" Height="24" Cursor="Hand" 
                            Background="Transparent" BorderThickness="0" ToolTip="Browse for .dds icon file">
                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                              Fill="{StaticResource TextMuted}" Stretch="Uniform" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <TextBlock Text="COMPONENTS" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding ItemEditor.CurrentItem.Traits}"
                              Background="Transparent" BorderThickness="0" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Background="{StaticResource BgMedium}" Margin="0,0,0,15" CornerRadius="4">
                                <StackPanel>
                                    <Border Background="{StaticResource BgLite}" Padding="10,5" CornerRadius="4,4,0,0">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕"
                                                    Command="{Binding DataContext.ItemEditor.RemoveTraitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource DangerButtonStyle}" Width="22" Height="22" ToolTip="Remove Trait"/>
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="{StaticResource HighlightCyan}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="10">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource HighlightBlue}"/>
                                                    </StackPanel>

                                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=250, ValidatesOnNotifyDataErrors=True}"
                                                             Style="{StaticResource ValidatedTextBoxStyle}" TextChanged="OnTextBoxTextChanged">
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding DataContext.ItemEditor.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding DataContext.ItemEditor.RedoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>