<UserControl x:Class="ItemEditor.Views.Components.TraitsListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:ItemEditor.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Border Background="{StaticResource BgMedium}" CornerRadius="0,0,5,0">
        <DockPanel Margin="10,10,0,10">
            <Grid DockPanel.Dock="Top" Margin="0,0,10,10">
                <TextBox x:Name="SearchTraitsBox"
                     Text="{Binding SearchTraitText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource BgLite}" Foreground="{StaticResource TextPrimary}"
                     BorderBrush="{StaticResource BorderMedium}" BorderThickness="1"
                     Padding="5" VerticalContentAlignment="Center"/>
                <TextBlock IsHitTestVisible="False" Text="Search traits..." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="7,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTraitsBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="TRAITS LIST:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,10,5"/>

            <ListBox ItemsSource="{Binding TraitsView}" Background="Transparent" BorderThickness="0" Padding="0,0,15,0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="0">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgLite}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderMedium}" BorderThickness="0,0,0,1" Padding="5,8,5,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource HighlightYellow}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding DataContext.AddTraitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Style="{StaticResource OutlineButtonStyle}" Background="Transparent"
                                    BorderBrush="{StaticResource BorderMedium}" Width="24" Height="24" Padding="0" VerticalAlignment="Center" ToolTip="Add Trait">
                                    <Path Data="{StaticResource Icon.Action.Add}" Width="12" Height="12" Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource HighlightCyan}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                        <Setter Property="Fill" Value="#666666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
