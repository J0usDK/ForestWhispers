<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <SolidColorBrush x:Key="BgDark" Color="#1E1E1E" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgMedium" Color="#252526" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgLite" Color="#333337" po:Freeze="True"/>
    <SolidColorBrush x:Key="BorderMedium" Color="#3E3E42" po:Freeze="True"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#D4D4D4" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextMuted" Color="#858585" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextWhite" Color="White" po:Freeze="True"/>

    <SolidColorBrush x:Key="AccentBlue" Color="#007ACC" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentBlueHover" Color="#0098FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentRed" Color="#A1260D" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentRedHover" Color="#C53013" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentRedPress" Color="#821E0A" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighlightCyan" Color="#4EC9B0" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighlightYellow" Color="#DCDCAA" po:Freeze="True"/>
    <SolidColorBrush x:Key="HighlightBlue" Color="#569CD6" po:Freeze="True"/>
</ResourceDictionary>